# Run infrastructure/scripts/bootstrap.ps1 to create .env with random credentials.
POSTGRES_PASSWORD=CHANGE_ME
RABBITMQ_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
DEMO_PASSWORD=CHANGE_ME
INGESTION_API_KEY=CHANGE_ME
GRAFANA_PASSWORD=CHANGE_ME

# Optional host database port; containers always use postgres:5432.
POSTGRES_PORT=55432
